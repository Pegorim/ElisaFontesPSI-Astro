---
import { siteContact } from '../data/site';

interface Props {
  label?: string;
  className?: string;
  showIcon?: boolean;
  ctaId?: string;
}

const {
  label = 'Agendar pelo WhatsApp',
  className = '',
  showIcon = true,
  ctaId = 'whatsapp_cta',
} = Astro.props;

---

<a
  href={siteContact.whatsappUrl}
  aria-label="Chat no WhatsApp"
  data-whatsapp-cta={ctaId}
  class={`inline-flex items-center gap-2 ${className}`}
>
  {showIcon && <img src="/images/whatsapp-icon.svg" alt="" class="w-5 h-5 invert" />}
  <span>{label}</span>
</a>
