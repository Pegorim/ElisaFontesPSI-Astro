---
import WhatsAppButton from './WhatsAppButton.astro';
import { siteContact } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);

const mainLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre a Elisa' },
  { href: '/blog', label: 'Blog' },
  { href: '/areas-atendidas', label: 'Consultório em Niterói' },
  { href: '/contato', label: 'Contato' },
];

const serviceLinks = [
  { href: '/terapia-online', label: 'Terapia online' },
  { href: '/psicoterapia-para-ansiedade', label: 'Psicoterapia para ansiedade' },
  { href: '/psicoterapia-adolescentes', label: 'Psicoterapia para adolescentes' },
  { href: '/psicanalise-e-psicoterapia', label: 'Psicanálise e psicoterapia' },
];

const contactLinkClass = 'inline-flex items-center gap-2 rounded-sm text-white/90 underline-offset-4 transition hover:text-white hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white';
const navLinkClass = 'rounded-sm px-2 py-2 text-sm font-medium underline-offset-8 transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent';
---

<aside class="bg-accent px-4 py-2.5 text-xs sm:text-sm" aria-label="Informações de contato">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-5 gap-y-2 lg:justify-between">
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      <a href={`tel:${siteContact.phoneInternational}`} class={contactLinkClass} data-contact-channel="phone">
        <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97c.37-.278.534-.75.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        <span>{siteContact.phoneDisplay}</span>
      </a>
      <a href={`mailto:${siteContact.email}`} class={contactLinkClass} data-contact-channel="email">
        <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5A2.25 2.25 0 0 1 19.5 19.5h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0-8.551 5.701a2.25 2.25 0 0 1-2.398 0L2.25 6.75" />
        </svg>
        <span>{siteContact.email}</span>
      </a>
    </div>
    <a href={siteContact.mapsUrl} class={contactLinkClass} target="_blank" rel="noreferrer" data-contact-channel="address">
      <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      <span>{siteContact.streetAddress} · {siteContact.locality}/{siteContact.region}</span>
    </a>
  </div>
</aside>

<nav class="sticky top-0 z-40 border-b border-text-main/10 bg-primary-bg/95 px-4 py-3 shadow-[0_8px_24px_rgba(74,64,54,0.06)] backdrop-blur md:px-8 lg:px-12" aria-label="Navegação principal">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6">
    <a href="/" class="flex min-w-0 items-center gap-3 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" aria-label="Elisa Fontes Psicologia — página inicial">
      <img src="/images/logo.png" alt="" class="h-12 w-12 shrink-0 rounded-full object-cover" width="48" height="48" />
      <span class="min-w-0">
        <span class="block truncate font-heading text-lg leading-tight text-text-main">Elisa Fontes</span>
        <span class="block truncate text-xs text-text-main/65">Psicóloga · CRP 05/62794</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {mainLinks.slice(0, 2).map((link) => (
        <a href={link.href} class:list={[navLinkClass, isActive(link.href) ? 'text-accent underline decoration-2' : 'text-text-main']} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}

      <details class="group relative">
        <summary class:list={[navLinkClass, 'flex cursor-pointer list-none items-center gap-1', serviceLinks.some((link) => isActive(link.href)) ? 'text-accent underline decoration-2' : 'text-text-main']}>
          Atendimentos
          <svg aria-hidden="true" class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
          </svg>
        </summary>
        <div class="absolute left-0 top-full mt-2 w-72 rounded-lg border border-text-main/10 bg-primary-bg p-2 shadow-xl">
          {serviceLinks.map((link) => (
            <a href={link.href} class:list={['block rounded-md px-4 py-3 text-sm transition-colors hover:bg-card-bg hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent', isActive(link.href) ? 'bg-card-bg text-accent' : 'text-text-main']} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      </details>

      {mainLinks.slice(2).map((link) => (
        <a href={link.href} class:list={[navLinkClass, isActive(link.href) ? 'text-accent underline decoration-2' : 'text-text-main']} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}

      <WhatsAppButton
        label="Agendar"
        className="ml-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        showIcon={false}
        ctaId="header_nav"
      />
    </div>

    <details class="group lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-text-main/20 px-4 py-2 text-sm font-medium text-text-main transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
        <span>Menu</span>
        <svg aria-hidden="true" class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg aria-hidden="true" class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </summary>
      <div class="absolute left-0 right-0 top-full max-h-[calc(100vh-5rem)] overflow-y-auto border-t border-text-main/10 bg-primary-bg px-5 py-5 shadow-xl">
        <div class="mx-auto flex max-w-7xl flex-col">
          {mainLinks.slice(0, 2).map((link) => (
            <a href={link.href} class:list={['rounded-md px-3 py-3 font-medium transition-colors hover:bg-card-bg hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent', isActive(link.href) ? 'bg-card-bg text-accent' : 'text-text-main']} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <p class="mt-3 px-3 text-xs font-bold uppercase tracking-[0.16em] text-accent/70">Atendimentos</p>
          {serviceLinks.map((link) => (
            <a href={link.href} class:list={['rounded-md px-3 py-3 pl-6 text-sm transition-colors hover:bg-card-bg hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent', isActive(link.href) ? 'bg-card-bg text-accent' : 'text-text-main/80']} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          {mainLinks.slice(2).map((link) => (
            <a href={link.href} class:list={['rounded-md px-3 py-3 font-medium transition-colors hover:bg-card-bg hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent', isActive(link.href) ? 'bg-card-bg text-accent' : 'text-text-main']} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <WhatsAppButton
            label="Agendar pelo WhatsApp"
            className="mt-4 justify-center rounded-full bg-accent px-6 py-3 font-medium text-white transition-colors hover:bg-accent/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            showIcon={false}
            ctaId="header_mobile_menu"
          />
        </div>
      </div>
    </details>
  </div>
</nav>
