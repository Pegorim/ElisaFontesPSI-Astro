---
import '../styles/global.css';
import { safeJsonLdSerialize } from 'emdash/page';
import { siteContact } from '../data/site';

interface Props {
	title: string;
    description?: string;
    image?: string;
    schema?: object | object[];
    includeDefaultSchema?: boolean;
    ogType?: string;
    noIndex?: boolean;
}

const {
    title,
    description = "Elisa Fontes, psicóloga clínica em Niterói, RJ. Atendimento presencial e online. Agende sua consulta e comece sua jornada de autoconhecimento.",
    image = "/images/profile.jpg",
    schema,
    includeDefaultSchema = false,
    ogType = "website",
    noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isPreviewOrEditRequest = Astro.url.searchParams.has('_preview') || Astro.url.searchParams.has('_edit');
const isProductionHostname = Astro.url.hostname === 'elisafontes.com.br';
const shouldNoIndex = noIndex || Astro.url.searchParams.has('_edit');
const shouldLoadAnalytics = import.meta.env.PROD && isProductionHostname && !isPreviewOrEditRequest;

const defaultSchema = {
    "@context": "https://schema.org",
    "@type": ["Psychologist", "LocalBusiness"],
    "name": "Elisa Fontes",
    "givenName": "Elisa",
    "familyName": "Fontes",
    "jobTitle": "Psicóloga Clínica",
    "medicalSpecialty": "Psychology",
    "description": "Psicóloga clínica em Niterói com 38 anos de experiência cuidando de pessoas. Atendimento presencial e online.",
    "url": "https://elisafontes.com.br",
    "telephone": siteContact.phoneInternational,
    "email": siteContact.email,
    "image": imageURL.href,
    "address": {
        "@type": "PostalAddress",
        "streetAddress": siteContact.streetAddress,
        "addressLocality": siteContact.locality,
        "addressRegion": siteContact.region,
        "postalCode": siteContact.postalCode,
        "addressCountry": "BR"
    },
    "openingHours": ["Mo-Sa 10:00-20:00"],
    "priceRange": "$$",
    "currenciesAccepted": "BRL",
    "paymentAccepted": "Dinheiro, PIX, Transferência",
    "sameAs": [
        "https://www.instagram.com/elisa12fontes"
    ],
    "areaServed": [
        {
            "@type": "City",
            "name": "Niterói"
        },
        {
            "@type": "Country",
            "name": "Brasil"
        }
    ],
    "knowsAbout": ["Psicanálise", "Ansiedade", "Depressão", "Terapia Online", "Psicologia Clínica"],
    "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "Professional License",
        "name": "CRP 05/62794"
    }
};

const customSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const structuredData = customSchemas.length
    ? includeDefaultSchema
        ? [defaultSchema, ...customSchemas]
        : customSchemas
    : defaultSchema;
const serializedStructuredData = shouldNoIndex ? null : safeJsonLdSerialize(structuredData);
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/logo.png" />
		<meta name="generator" content={Astro.generator} />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:site_name" content="Terapia com Elisa" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        {shouldNoIndex && <meta name="robots" content="noindex,nofollow,noarchive" />}

        <!-- Structured Data -->
        {serializedStructuredData && (
            <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
        )}

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

		<title>{title}</title>

        {shouldLoadAnalytics && (
            <>
                <!-- Google Analytics 4 (installed directly; do not duplicate in GTM) -->
                <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6RJEY1WCFN"></script>
                <script is:inline>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', 'G-6RJEY1WCFN');
                </script>
                <!-- End Google Analytics 4 -->
            </>
        )}

        {shouldLoadAnalytics && (
            <>
                <!-- Google Tag Manager -->
                <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                })(window,document,'script','dataLayer','GTM-KH64XF44');</script>
                <!-- End Google Tag Manager -->
            </>
        )}
	</head>
	<body class="antialiased min-h-screen flex flex-col overflow-x-hidden">
        {shouldLoadAnalytics && (
            <>
                <!-- Google Tag Manager (noscript) -->
                <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KH64XF44"
                height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
                <!-- End Google Tag Manager (noscript) -->
            </>
        )}
		<slot />

    <!-- Floating WhatsApp CTA -->
    <a
      href={siteContact.whatsappUrl}
      class="fixed z-50 bottom-5 right-5 w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#25D366] shadow-lg flex items-center justify-center hover:bg-[#1ebe5b] transition-colors"
      aria-label="Fale com Elisa no WhatsApp"
      data-whatsapp-cta="floating_button"
    >
      <img src="/images/whatsapp-icon.svg" alt="" class="w-7 h-7 invert" />
    </a>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const whatsappLink = target.closest('a[data-whatsapp-cta]');

        if (whatsappLink) {
          window.dataLayer.push({
            event: 'whatsapp_cta_click',
            cta_id: whatsappLink.dataset.whatsappCta || 'whatsapp_cta',
            cta_text: whatsappLink.textContent.trim().replace(/\s+/g, ' '),
            page_path: window.location.pathname,
            cta_href: whatsappLink.href,
          });
          return;
        }

        const contactLink = target.closest('a[data-contact-channel]');

        if (!contactLink) return;

        window.dataLayer.push({
          event: 'contact_link_click',
          contact_channel: contactLink.dataset.contactChannel,
          page_path: window.location.pathname,
          contact_href: contactLink.href,
        });
      });
    </script>
	</body>
</html>
