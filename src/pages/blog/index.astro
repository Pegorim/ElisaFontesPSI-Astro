---
import { Image } from 'emdash/ui';

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { formatBlogDate, getBlogImage, getPublishedBlogPosts } from '../../utils/emdash-blog';

const posts = await getPublishedBlogPosts();

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog | Elisa Fontes - Psicóloga',
  description: 'Artigos sobre ansiedade, autoestima, autoconhecimento e saúde mental.',
  url: 'https://elisafontes.com.br/blog',
  author: {
    '@type': 'Person',
    name: 'Elisa Fontes',
    jobTitle: 'Psicóloga Clínica',
  },
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publication_date,
    url: `https://elisafontes.com.br/blog/${post.id}`,
  })),
};
---

<Layout
  title="Blog | Elisa Fontes - Psicóloga em Niterói"
  description="Artigos sobre ansiedade, autoestima, autoconhecimento e saúde mental. Conteúdo escrito por Elisa Fontes, psicóloga clínica."
  schema={blogSchema}
>
  <Header />

  <main class="bg-primary-bg px-6 py-12 md:px-12 lg:px-20">
    <section class="mx-auto mb-12 max-w-6xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-accent/75">Saúde mental com informação responsável</p>
      <h1 class="mb-4 border-b border-text-main/20 pb-4 font-heading text-4xl text-text-main md:text-5xl">Blog</h1>
      <p class="max-w-3xl text-lg leading-8 text-text-main/70">
        Reflexões sobre ansiedade, relações, autoconhecimento e psicoterapia, escritas para orientar sem substituir uma avaliação profissional individual.
      </p>
    </section>

    <section class="mx-auto max-w-6xl" aria-label="Artigos publicados">
      <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="group overflow-hidden rounded-xl bg-card-bg shadow-sm transition-shadow hover:shadow-lg" {...post.edit}>
            <a href={`/blog/${post.id}`} class="block h-full rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
              <div class="aspect-[4/3] overflow-hidden bg-card-bg">
                {getBlogImage(post.data) ? (
                  <Image
                    image={getBlogImage(post.data)}
                    alt={post.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-6xl text-text-main/25" aria-hidden="true">✦</div>
                )}
              </div>

              <div class="p-5">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                  <span class="inline-block rounded-sm bg-primary-bg px-3 py-1 text-xs font-medium text-text-main">{post.data.category}</span>
                  <time class="text-xs text-text-main/55" datetime={post.data.publication_date}>{formatBlogDate(post.data.publication_date)}</time>
                </div>
                <h2 class="line-clamp-2 font-heading text-xl text-text-main transition-colors group-hover:text-accent">{post.data.title}</h2>
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-text-main/70">{post.data.description}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-accent">
                  Ler artigo <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
