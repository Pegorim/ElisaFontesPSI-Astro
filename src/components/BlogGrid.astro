---
import { Image } from 'emdash/ui';
import { formatBlogDate, getBlogImage, getPublishedBlogPostsOrEmpty } from '../utils/emdash-blog';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const posts = await getPublishedBlogPostsOrEmpty(limit, 'blog grid');
---

{posts.length > 0 && (
  <section id="blog" class="bg-stone-50 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex items-end justify-between">
        <div>
          <h2 class="mb-2 font-heading text-3xl font-bold text-text-main md:text-4xl">Blog & Reflexões</h2>
          <p class="text-text-main/60">Artigos para nutrir sua saúde mental</p>
        </div>
        {limit && (
          <a href="/blog" class="hidden rounded-sm font-bold text-accent underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent md:inline-block">
            Ver todos os posts &rarr;
          </a>
        )}
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {posts.map((post) => (
          <article class="group overflow-hidden rounded-2xl bg-white shadow-sm transition-all duration-300 hover:shadow-lg" {...post.edit}>
            <a href={`/blog/${post.id}`} class="block rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
              <div class="relative h-48 overflow-hidden bg-card-bg">
                {getBlogImage(post.data) ? (
                  <Image
                    image={getBlogImage(post.data)}
                    alt={post.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    sizes="(min-width: 768px) 33vw, 100vw"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-5xl text-accent/20" aria-hidden="true">✦</div>
                )}
                <div class="absolute inset-0 bg-accent/10 transition-colors group-hover:bg-transparent"></div>
              </div>

              <div class="p-6">
                <span class="mb-4 inline-block rounded-full bg-stone-100 px-3 py-1 text-xs font-bold tracking-widest text-accent">
                  {post.data.category}
                </span>
                <h3 class="mb-2 font-heading text-xl font-bold text-text-main transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
                <p class="mb-4 line-clamp-3 text-sm text-text-main/70">{post.data.description}</p>
                <time class="block border-t border-stone-100 pt-4 text-xs text-text-main/45" datetime={post.data.publication_date}>
                  {formatBlogDate(post.data.publication_date)}
                </time>
              </div>
            </a>
          </article>
        ))}
      </div>

      {limit && (
        <div class="mt-8 text-center md:hidden">
          <a href="/blog" class="inline-block rounded-sm font-bold text-accent underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
            Ver todos os posts &rarr;
          </a>
        </div>
      )}
    </div>
  </section>
)}
