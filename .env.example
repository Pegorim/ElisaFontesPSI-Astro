# Produção: disponibilizar durante o build e durante a execução.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require
S3_ENDPOINT=https://REGION.digitaloceanspaces.com
S3_BUCKET=elisa-fontes-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=REGION
S3_PUBLIC_URL=https://elisa-fontes-media.REGION.cdn.digitaloceanspaces.com
EMDASH_ENCRYPTION_KEY=replace-with-npx-emdash-secrets-generate

# Execução do servidor Astro.
HOST=0.0.0.0
PORT=8080
